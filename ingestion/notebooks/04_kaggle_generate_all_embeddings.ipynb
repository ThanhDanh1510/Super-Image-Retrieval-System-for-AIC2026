 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# AIC2026 — Kaggle Notebook: Generate All Vector Embeddings (GPU)\n",
    "\n",
    "**Mục đích:** Nạp dữ liệu thô hợp nhất (`scene_metadata.parquet`, `ocr_text.parquet`, `asr_text.parquet`, `keyframes/`), sử dụng **GPU Kaggle** để sinh đồng thời:\n",
    "1. `image_vectors.npy` (1024-dim, BEiT3 + CLIP, L2-normalized)\n",
    "2. `ocr_vectors.npy` (1536-dim, gte-Qwen2-1.5B, L2-normalized)\n",
    "3. `asr_vectors.npy` (1536-dim, gte-Qwen2-1.5B, L2-normalized)\n",
    "4. `scene_ids.txt` (khớp 1-to-1 thứ tự các hàng)\n",
    "\n",
    "**Đầu ra:** File `unified_dataset.zip` tải về máy local để nạp vào Qdrant DB qua `python -m indexing.run_index`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Install dependencies\n",
    "!pip install -q transformers pillow soundfile accelerate torch numpy pandas pyarrow pyyaml\n",
    "\n",
    "import os\n",
    "import zipfile\n",
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "\n",
    "print(f\"CUDA Available: {torch.cuda.is_available()}\")\n",
    "if torch.cuda.is_available():\n",
    "    print(f\"GPU Name: {torch.cuda.get_device_name(0)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Clone codebase hoặc thiết lập path\n",
    "OUTPUT_DIR = Path(\"/kaggle/working/unified_dataset\")\n",
    "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Đường dẫn tới dataset input tải lên Kaggle (sửa lại nếu đổi tên Dataset)\n",
    "INPUT_DATASET = Path(\"/kaggle/input/aic2026-unified-raw\")\n",
    "if not INPUT_DATASET.exists():\n",
    "    # Thử tìm folder bất kỳ trong /kaggle/input/\n",
    "    inputs = list(Path(\"/kaggle/input\").glob(\"*\"))\n",
    "    if inputs:\n",
    "        INPUT_DATASET = inputs[0]\n",
    "        print(f\"Tự động chọn input dataset: {INPUT_DATASET}\")\n",
    "\n",
    "print(f\"INPUT_DATASET: {INPUT_DATASET}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. Clone repo để lấy modules shared & ingestion\n",
    "if not Path(\"AIC2026\").exists():\n",
    "    !git clone https://github.com/ThanhDanh1510/Super-Image-Retrieval-System-for-AIC2026.git AIC2026\n",
    "\n",
    "import sys\n",
    "sys.path.append(str(Path(\"AIC2026\").absolute()))\n",
    "\n",
    "from shared.models.image_embedding_wrapper import ImageEmbeddingWrapper\n",
    "from shared.models.text_embedding_wrapper import TextEmbeddingWrapper\n",
    "from ingestion.skeletons.01c_embedding_generation import run_embedding_generation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4. Chạy Pipeline sinh Embeddings bằng GPU\n",
    "metadata_path = str(INPUT_DATASET / \"scene_metadata.parquet\")\n",
    "ocr_path = str(INPUT_DATASET / \"ocr_text.parquet\")\n",
    "asr_path = str(INPUT_DATASET / \"asr_text.parquet\")\n",
    "keyframe_dir = str(INPUT_DATASET / \"keyframes\")\n",
    "\n",
    "run_embedding_generation(\n",
    "    metadata_path=metadata_path,\n",
    "    ocr_path=ocr_path,\n",
    "    asr_path=asr_path,\n",
    "    keyframe_dir=keyframe_dir,\n",
    "    output_dir=str(OUTPUT_DIR),\n",
    "    device=\"cuda\" if torch.cuda.is_available() else \"cpu\",\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5. Copy parquets và đóng gói thành unified_dataset.zip cho local download\n",
    "import shutil\n",
    "\n",
    "shutil.copy2(metadata_path, OUTPUT_DIR / \"scene_metadata.parquet\")\n",
    "shutil.copy2(ocr_path, OUTPUT_DIR / \"ocr_text.parquet\")\n",
    "shutil.copy2(asr_path, OUTPUT_DIR / \"asr_text.parquet\")\n",
    "\n",
    "# Đóng gói zip\n",
    "zip_filename = \"/kaggle/working/unified_dataset.zip\"\n",
    "with zipfile.ZipFile(zip_filename, 'w', zipfile.ZIP_DEFLATED) as zipf:\n",
    "    for file in OUTPUT_DIR.rglob(\"*\"):\
    "        if file.is_file():\n",
    "            zipf.write(file, arcname=file.relative_to(OUTPUT_DIR))\n",
    "\n",
    "print(f\"✅ ĐÃ HOÀN THÀNH VÀ ĐÓNG GÓI: {zip_filename}\")\n",
    "print(f\"Kích thước file zip: {os.path.getsize(zip_filename) / (1024*1024):.2f} MB\")"
   ]
  }
 ],
