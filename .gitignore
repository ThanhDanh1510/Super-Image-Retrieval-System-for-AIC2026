# =============================================================================
# .gitignore — AIC2026 Super Image Retrieval System
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl

# --- Virtual environments ---
.venv/
venv/
env/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Environment & Secrets ---
.env
*.env.local
kaggle.json

# --- Data & Storage (không commit video, ảnh, vector, database lên Git) ---
data/
storage/
*.npy
*.npz
*.parquet
*.h5
*.hdf5
*.onnx
*.pt
*.pth
*.bin
*.safetensors
*.zip
*.rar
*.tar
*.gz
*.7z

# --- Binaries & Executables ---
*.exe
tools/bin/*.exe
tools/bin/qdrant.exe

# --- Qdrant snapshots & local state ---
*.snapshot
*.qdrant-initialized
.qdrant-initialized

# --- Kaggle ---
/kaggle/

# --- Logs ---
logs/
*.log

# --- Jupyter Notebooks & checkpoints (để chạy nháp trên Kaggle, không commit) ---
.ipynb_checkpoints/
*.ipynb
ingestion/notebooks/

# --- Coverage & Testing ---
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# --- Temporary debug & test output files ---
*_zoom.webp
temp_*.json
*.quality.tmp
data/ocr_test_output/
data/translation_cache.json
data/backups/
data/archive/

# --- Scratch & orphaned temp files ---
scratch/
L_by_scene_id.json
prompt*.md
test_body.json
tasks.md
folder_structure.md
server.log
server_error.log
