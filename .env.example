# =============================================================================
# Cache Paths (Cấu hình đường dẫn lưu cache cho các thư viện ML - Tránh đầy ổ C)
# =============================================================================
# Thường trỏ sang phân vùng ổ đĩa lớn hơn (Ví dụ: D:\huggingface_cache)
HF_HOME=./data/hf_cache
HF_HUB_CACHE=./data/hf_cache/hub
TRANSFORMERS_CACHE=./data/hf_cache/hub
PADDLE_HOME=./data/paddle_cache
PADDLEOCR_BASE_DIR=./data/paddle_cache
TORCH_HOME=./data/torch_cache

# =============================================================================
# .env.example — Template biến môi trường cho AIC2026
# =============================================================================
# Copy file này thành .env và điền giá trị phù hợp:
#   cp .env.example .env
#
# Prefix: AIC_ (khớp với serving/api/core/config.py :: Settings.model_config)
# =============================================================================

# --- App ---
AIC_APP_NAME="AIC2026 Retrieval API"
AIC_APP_VERSION="0.1.0"
AIC_DEBUG=false

# --- Qdrant ---
AIC_QDRANT_URL=http://localhost:6333
AIC_QDRANT_API_KEY=
AIC_QDRANT_COLLECTION_ALIAS=production

# --- Model Loading ---
AIC_DEVICE=cuda
AIC_TEXT_EMBEDDING_BATCH_SIZE=16
AIC_IMAGE_EMBEDDING_BATCH_SIZE=32

# --- RAM Saver (Lazy Model Loading) ---
# false: model chỉ được tải khi endpoint đầu tiên cần đến (mặc định, tiết kiệm RAM)
# true:  warmup toàn bộ model ngay lúc startup (request đầu không bị delay)
AIC_PRELOAD_MODELS=false
# Unload model không dùng sau N giây (0 = không tự unload)
AIC_MODEL_UNLOAD_TTL_S=0
# Chu kỳ (giây) background task kiểm tra model idle
AIC_MODEL_IDLE_CHECK_S=30

# --- Static Files ---
# Mặc định: data/ ở root dự án. Override nếu cần mount từ nơi khác.
AIC_DATA_DIR=./data
AIC_KEYFRAME_DIR=./data/image

# --- Server ---
AIC_HOST=0.0.0.0
AIC_PORT=8000
AIC_WORKERS=1

# --- CORS ---
# Cho phép tất cả origin lúc thi. Production nên restrict lại.
AIC_CORS_ORIGINS=["*"]
